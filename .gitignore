# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Private document vault (never commit user uploads)
/storage/
/var/storage/

# vBizMe public-card export artifacts
/migration_export/
/migration/**/__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
